# =============================
# Yomy frontend (safe to expose)
# =============================
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY

# WebRTC: use a real TURN service in production for reliable calls behind NAT.
VITE_TURN_URLS=turn:YOUR_TURN_HOST:443,turns:YOUR_TURN_HOST:443
VITE_TURN_USERNAME=YOUR_TURN_USERNAME
VITE_TURN_CREDENTIAL=YOUR_TURN_CREDENTIAL

# =============================
# Supabase Edge Functions (server-side secrets)
# Never prefix these with VITE_ and never commit real values.
# =============================
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_IN_SUPABASE_FUNCTION_SECRETS

# =============================
# Content moderation
# =============================
GEMINI_API_KEY=SET_IN_SUPABASE_FUNCTION_SECRETS
GEMINI_MODEL=gemini-2.5-flash-lite

# =============================
# Multi-shard media routing (server-side secret JSON)
# =============================
MEDIA_SHARDS_JSON=SET_IN_SUPABASE_FUNCTION_SECRETS
VITE_MEDIA_ROUTER_FUNCTION=fedo-upload-ticket
